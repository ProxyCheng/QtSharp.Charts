<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The core binding. It is not on nuget.org: each QtSharp release publishes QtSharp.Api.nupkg
         as a GitHub Release asset, and scripts/Fetch-Core.ps1 downloads it into packages\. -->
    <add key="qtsharp" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
